{
  "name": "orders-products",
  "version": "1.1.0",
  "private": true,
  "description": "Inventory SPA: orders and products with realtime sessions counter",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @op/web",
    "dev:api": "npm run dev -w @op/api",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run format:check && npm run icons:check && npm run lint && npm run typecheck && npm run test",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @op/api",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "npm run icons -w @op/web",
    "icons:check": "npm run icons:check -w @op/web",
    "analyze": "npm run analyze -w @op/web",
    "db:up": "docker compose up -d mysql",
    "db:generate": "npm run db:generate -w @op/api",
    "db:migrate": "npm run db:migrate -w @op/api",
    "db:deploy": "npm run db:deploy -w @op/api",
    "db:seed": "npm run db:seed -w @op/api",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "prepare": "husky",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,scss,css,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1"
  }
}
