generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum Currency {
  USD
  UAH
}

enum ProductStatus {
  FREE
  IN_REPAIR
  IN_USE
}

model User {
  id           Int              @id @default(autoincrement())
  email        String           @unique @db.VarChar(191)
  passwordHash String           @map("password_hash") @db.VarChar(255)
  name         String           @db.VarChar(120)
  avatarUrl    String?          @map("avatar_url") @db.VarChar(500)
  createdAt    DateTime         @default(now()) @map("created_at")
  products     Product[]
  sessions     RefreshSession[]

  @@map("users")
}

model RefreshSession {
  id        String   @id @db.VarChar(36)
  tokenHash String   @map("token_hash") @db.Char(64)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model Order {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  description String?   @db.Text
  date        DateTime
  createdAt   DateTime  @default(now()) @map("created_at")
  products    Product[]

  @@map("orders")
}

model ProductGroup {
  id       Int       @id @default(autoincrement())
  title    String    @db.VarChar(255)
  products Product[]

  @@map("product_groups")
}

model Product {
  id             Int           @id @default(autoincrement())
  serialNumber   String        @unique @map("serial_number") @db.VarChar(64)
  isNew          Boolean       @default(true) @map("is_new")
  photo          String?       @db.VarChar(500)
  title          String        @db.VarChar(255)
  type           String        @db.VarChar(64)
  specification  String        @db.VarChar(255)
  status         ProductStatus @default(FREE)
  guaranteeStart DateTime      @map("guarantee_start")
  guaranteeEnd   DateTime      @map("guarantee_end")
  date           DateTime
  orderId        Int           @map("order_id")
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  groupId        Int?          @map("group_id")
  group          ProductGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  userId         Int?          @map("user_id")
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  prices         Price[]

  @@index([type])
  @@index([orderId])
  @@map("products")
}

model Price {
  id        Int      @id @default(autoincrement())
  value     Decimal  @db.Decimal(12, 2)
  symbol    Currency
  isDefault Boolean  @default(false) @map("is_default")
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, symbol])
  @@map("prices")
}
